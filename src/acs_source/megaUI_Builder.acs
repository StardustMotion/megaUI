
#DEFINE MGUI_BUILDER_SFX_NO             "misc/wanaan"
#DEFINE MGUI_BUILDER_SFX_STAMP_ADD      "misc/mercuryconveyorswitch"
#DEFINE MGUI_BUILDER_SFX_STAMP_REMOVE   "misc/eclipsedarkshot"
#DEFINE MGUI_BUILDER_SFX_TOGGLE         "misc/cursorq"
#DEFINE MGUI_BUILDER_SFX_RESET          "misc/fakereloadshort"
#DEFINE MGUI_BUILDER_SFX_BRUSH          "misc/venusdrip"

#DEFINE MGUI_BUILDER_MODE_SELECT        0
#DEFINE MGUI_BUILDER_MODE_STAMP_MOVE    1
#DEFINE MGUI_BUILDER_MODE_STAMP_SCALE   2

#DEFINE MGUI_BUILDER_MOUSE_DELTA        0.002
#DEFINE MGUI_BUILDER_SCALE_DELTA        1.03

bool    mguiBuilderIsRunning,
        mguiBuilderIsUniformScale;
str     mguiBuilderStampGraphic;
int     mguiBuilderXFactor,
        mguiBuilderYFactor,
        mguiBuilderMode;

function int MGUI_FactorToHud(int factor, int hud) { return (factor * hud)>>16; }

function void MGUI_SetBuilderMode(int mode) {
    mguiBuilderMode = mode;
    switch(mode) {

        case MGUI_BUILDER_MODE_SELECT:
            SetMouseCursor("MEGAUI_3");
            SetMouseOffset(6, 8);
            break;

        case MGUI_BUILDER_MODE_STAMP_MOVE:
            SetMouseCursor("MEGAUI_4");
            SetMouseOffset(0, 0);
            SetMouseSpeed(1.0);
            break;

        case MGUI_BUILDER_MODE_STAMP_SCALE:
            SetMouseCursor("MEGAUI_5");
            SetMouseSpeed(0.0);
            break;
    }
}

script "MegaUI Builder" (void) CLIENTSIDE {
    if(!StartMouseMenu("MegaUI Builder Event"))
        terminate;
    mguiBuilderIsRunning = true;
    mguiBuilderIsUniformScale = true;
    int prevMouseX, prevMouseY, mouseX, mouseY;
    ACS_NamedExecuteWithResult("core_freezeplayer",0,true);

    MGUI_SetBuilderMode(MGUI_BUILDER_MODE_SELECT);

    while(true) {
        mouseX = GetMouseX();
        mouseY = GetMouseY();
        int input = GetPlayerInput(-1, INPUT_BUTTONS);
        int prevInput = GetPlayerInput(-1, INPUT_OLDBUTTONS);
        int pressedInput = (input ^ prevInput) & ~prevInput;
        MGUI_BuilderSpecialInputCheck(pressedInput);

        // Stamp Move mode
        if(mguiBuilderMode == MGUI_BUILDER_MODE_STAMP_MOVE) {
            // Keyboard WASD 
            if(input & BT_MOVELEFT)       SetMouseX(mouseX-MGUI_BUILDER_MOUSE_DELTA);
            else if(input & BT_MOVERIGHT) SetMouseX(mouseX+MGUI_BUILDER_MOUSE_DELTA);
            if(input & BT_FORWARD)        SetMouseY(mouseY-MGUI_BUILDER_MOUSE_DELTA);
            else if(input & BT_BACK)      SetMouseY(mouseY+MGUI_BUILDER_MOUSE_DELTA);
        }
        // Stamp Scale mode
        else if(mguiBuilderMode == MGUI_BUILDER_MODE_STAMP_SCALE) {
            // Mouse
            int rawMouseDeltaX = GetRawMouseDeltaX()<<4;
            int rawMouseDeltaY = GetRawMouseDeltaY()<<4;
            if((rawMouseDeltaX > 0) | (rawMouseDeltaY > 0)) {
                if(mguiBuilderIsUniformScale) {
                    int tmp = MGUI_Max(rawMouseDeltaX, rawMouseDeltaY);
                    mguiBuilderXFactor = FixedMul(mguiBuilderXFactor, 1.0 + tmp);
                    mguiBuilderYFactor = FixedMul(mguiBuilderYFactor, 1.0 + tmp);
                }
                else {
                    if(rawMouseDeltaX > 0)  mguiBuilderXFactor = FixedMul(mguiBuilderXFactor, 1.0 + rawMouseDeltaX);
                    if(rawMouseDeltaY > 0)  mguiBuilderYFactor = FixedMul(mguiBuilderYFactor, 1.0 + rawMouseDeltaY);
                }
            }
            else if((rawMouseDeltaX < 0) | (rawMouseDeltaY < 0)) {
                if(mguiBuilderIsUniformScale) {
                    tmp = MGUI_Min(rawMouseDeltaX, rawMouseDeltaY);
                    mguiBuilderXFactor = FixedDiv(mguiBuilderXFactor, 1.0 - tmp);
                    mguiBuilderYFactor = FixedDiv(mguiBuilderYFactor, 1.0 - tmp);
                }
                else {
                    if(rawMouseDeltaX < 0)  mguiBuilderXFactor = FixedDiv(mguiBuilderXFactor, 1.0 - rawMouseDeltaX);
                    if(rawMouseDeltaY < 0)  mguiBuilderYFactor = FixedDiv(mguiBuilderYFactor, 1.0 - rawMouseDeltaY);
                }
            }

            // Keyboard WASD 
            if(input & (BT_MOVELEFT|BT_FORWARD)) {
                if((input & BT_MOVELEFT) | mguiBuilderIsUniformScale)
                    mguiBuilderXFactor = FixedMul(mguiBuilderXFactor, MGUI_BUILDER_SCALE_DELTA);
                if((input & BT_FORWARD) | mguiBuilderIsUniformScale)         
                    mguiBuilderYFactor = FixedMul(mguiBuilderYFactor, MGUI_BUILDER_SCALE_DELTA);
            }
            else if(input & (BT_MOVERIGHT|BT_BACK)) {
                if((input & BT_MOVERIGHT)|mguiBuilderIsUniformScale)         
                    mguiBuilderXFactor = FixedDiv(mguiBuilderXFactor, MGUI_BUILDER_SCALE_DELTA);
                if((input & BT_BACK)|mguiBuilderIsUniformScale)         
                    mguiBuilderYFactor = FixedDiv(mguiBuilderYFactor, MGUI_BUILDER_SCALE_DELTA);
            }

        }

        if((mguiBuilderMode == MGUI_BUILDER_MODE_STAMP_MOVE) | (mguiBuilderMode == MGUI_BUILDER_MODE_STAMP_SCALE)) {

            int hudWidth = MGUI_FactorToHud(mguiBuilderXFactor, MGUI_HUD_WIDTH), 
                hudHeight = MGUI_FactorToHud(mguiBuilderYFactor, MGUI_HUD_HEIGHT),
                x = (mouseX*hudWidth)>>16,
                y = (mouseY*hudHeight)>>16;
            Draw(mguiBuilderStampGraphic, x, y, hudWidth, hudHeight, 1.0);
        }
        delay(1);
        prevMouseX = mouseX;
        prevMouseY = mouseY;
    }
    ACS_NamedExecuteWithResult("core_freezeplayer",0,false);
    mguiBuilderIsRunning = false;
    EndMouseMenu();
}





script "MegaUI Builder Chat" (int type, int message, int arg2) EVENT {
    if(!mguiBuilderIsRunning)
        terminate;;
    if (type == GAMEEVENT_CHAT) {
        MGUI_EditStamp(GetChatMessage(message, 0), 1.0, 1.0);
    }
}


function void MGUI_BuilderSpecialInputCheck(int input) {
    if(input & BT_RELOAD) {
        mguiBuilderXFactor = 1.0;
        mguiBuilderYFactor = 1.0;
        MGUI_Play(MGUI_BUILDER_SFX_RESET);
        MGUI_Log("Reset scale.");
    }
    if(input & BT_SHOWSCORES) {
        MGUI_Play(MGUI_BUILDER_SFX_TOGGLE);
        mguiBuilderIsUniformScale = !mguiBuilderIsUniformScale;
        MGUI_Log(strParam(s:"Uniform scale : ", d:mguiBuilderIsUniformScale));
    }


}

// -------------------------------------------------------------------------------------------
//      Stamps
// -------------------------------------------------------------------------------------------

#DEFINE MGUI_BUILDER_STAMP_MAX              3
#DEFINE MGUI_BUILDER_STAMP_DRAWID           MGUI_DEBUG_AREA_DRAWID_END
#DEFINE MGUI_BUILDER_STAMP_DRAWID_END       MGUI_BUILDER_STAMP_DRAWID + (MGUI_BUILDER_STAMP_MAX * 2) // 1 image and 1 setting icon
#DEFINE MGUI_BUILDER_STAMP_HOOK_ALPHA       0.4

int mguiBuilderStampCount = 0;
int mguiBuilderStampValue[MGUI_BUILDER_STAMP_MAX+1]; 
int mguiBuilderStampX[MGUI_BUILDER_STAMP_MAX+1]; 
int mguiBuilderStampY[MGUI_BUILDER_STAMP_MAX+1]; 
int mguiBuilderStampXFactor[MGUI_BUILDER_STAMP_MAX+1]; 
int mguiBuilderStampYFactor[MGUI_BUILDER_STAMP_MAX+1]; 

function int MGUI_GetStampGraphicId(int slot) { return (MGUI_BUILDER_STAMP_DRAWID_END - 1) - (slot<<1); }
function int MGUI_GetStampGraphicSlot(int graphicId) { return ((MGUI_BUILDER_STAMP_DRAWID_END - 1) - graphicId)>>1; }
    

function bool MGUI_AddStamp(str value) {
    if(mguiBuilderStampCount == MGUI_BUILDER_STAMP_MAX)
        return false;

    int slot = mguiBuilderStampCount;
    MGUI_SetStamp(slot, value, GetMouseX(), GetMouseY(), mguiBuilderXFactor, mguiBuilderYFactor);

    mguiBuilderStampCount++;
    return true;
}

function void MGUI_SetStamp(int slot, str value, int x, int y, int xFactor, int yFactor) {
    mguiBuilderStampValue[slot] =       value;
    mguiBuilderStampX[slot] =           x;
    mguiBuilderStampY[slot] =           y;
    mguiBuilderStampXFactor[slot] =     xFactor;
    mguiBuilderStampYFactor[slot] =     yFactor;

    int id = MGUI_GetStampGraphicId(slot);

    int hudWidth = MGUI_FactorToHud(xFactor, MGUI_HUD_WIDTH),
        hudHeight = MGUI_FactorToHud(yFactor, MGUI_HUD_HEIGHT);

    Show(id, value, (x*hudWidth)>>16, (y*hudHeight)>>16, hudWidth, hudHeight, 1.0);
    SetMouseArea(id, (x*320)>>16, (y*240)>>16, 16, 16, 320, 240);
    MGUI_DrawStampHook(id, MGUI_BUILDER_STAMP_HOOK_ALPHA);
}

function void MGUI_RemoveStamp(int stampId) {
    for(int slotA = 0; slotA < mguiBuilderStampCount; slotA++) {
        if(MGUI_GetStampGraphicId(slotA) == stampId) {


            for(int slotB = slotA; slotB < mguiBuilderStampCount; slotB++) {
                MGUI_SetStamp(slotB, 
                    mguiBuilderStampValue[slotB+1], 
                    mguiBuilderStampX[slotB+1], 
                    mguiBuilderStampY[slotB+1], 
                    mguiBuilderStampXFactor[slotB+1], 
                    mguiBuilderStampYFactor[slotB+1]);
            }

            // Erase the last one
            int id = MGUI_GetStampGraphicId(mguiBuilderStampCount-1);
            DeleteMouseArea(id);
            Hide(id);
            Hide(id-1);
            mguiBuilderStampCount--;
            return;
        }
    }
}


function void MGUI_EditStamp(int value, int xFactor, int yFactor) {
    MGUI_Play(MGUI_BUILDER_SFX_BRUSH);
    mguiBuilderStampGraphic = value; 
    mguiBuilderXFactor = xFactor;
    mguiBuilderYFactor = yFactor;
    MGUI_SetBuilderMode(MGUI_BUILDER_MODE_STAMP_MOVE);
}

// -------------------------------------------------------------------------------------------
//      Misc / utils
// -------------------------------------------------------------------------------------------

function void MGUI_Play(str sound) { LocalAmbientSound(sound,127); }




















function void MGUI_DrawStampHook(int areaId, int alpha) {
    int slot = MGUI_GetStampGraphicSlot(areaId);
    Show(areaId-1, "MEGAUI_6", (mguiBuilderStampX[slot]*320)>>16, (mguiBuilderStampY[slot]*240)>>16, 320, 240, alpha);
}


script "MegaUI Builder Event" (int e, int areaId) CLIENTSIDE {
    switch(e) {

        // Mouse enters area
        case MGUI_EVENT_ENTER:
            MGUI_DrawStampHook(areaId, 1.0);
            break;

        // Mouse exits area
        case MGUI_EVENT_EXIT:
            MGUI_DrawStampHook(areaId, MGUI_BUILDER_STAMP_HOOK_ALPHA);
            break;

        // Left click press
        case MGUI_EVENT_DOWN:
            switch(mguiBuilderMode) {
                case MGUI_BUILDER_MODE_SELECT:
                    if(areaId != MGUI_AREA_NULL) {
                        int daSlot = MGUI_GetStampGraphicSlot(areaId);
                        MGUI_EditStamp(mguiBuilderStampValue[daSlot], mguiBuilderStampXFactor[daSlot], mguiBuilderStampYFactor[daSlot]);
                        MGUI_RemoveStamp(areaId);
                    }
                    break;
                case MGUI_BUILDER_MODE_STAMP_MOVE:
                case MGUI_BUILDER_MODE_STAMP_SCALE:
                    if(!MGUI_AddStamp(mguiBuilderStampGraphic))     MGUI_Play(MGUI_BUILDER_SFX_NO);
                    else                                            MGUI_Play(MGUI_BUILDER_SFX_STAMP_ADD);
                    MGUI_SetBuilderMode(MGUI_BUILDER_MODE_SELECT);
                    break;
            }
            break;

        // Right click press
        case MGUI_EVENT_ALT_DOWN:
            switch(mguiBuilderMode) {

                case MGUI_BUILDER_MODE_SELECT: 
                    if(areaId != MGUI_AREA_NULL) {
                        MGUI_Play(MGUI_BUILDER_SFX_STAMP_REMOVE);
                        MGUI_RemoveStamp(areaId);
                    }
                    break;

                case MGUI_BUILDER_MODE_STAMP_MOVE:
                    MGUI_SetBuilderMode(MGUI_BUILDER_MODE_STAMP_SCALE);
                    break;
            }
            break;

        // Right click release
        case MGUI_EVENT_ALT_UP:
            switch(mguiBuilderMode) {
                case MGUI_BUILDER_MODE_STAMP_SCALE:
                    MGUI_SetBuilderMode(MGUI_BUILDER_MODE_STAMP_MOVE);
                    break;
            }
            break;
    }
}


















