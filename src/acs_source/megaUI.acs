// -------------------------------------------------------------------------------------------
//      General
// -------------------------------------------------------------------------------------------

/*
- To use MegaUI, copy this megaUI.acs file to your mod and use #include "megaUI.acs"
    - Also, iif you use the MGUI_DEBUG mode below, copy MegaUI's graphics/debug content to your mod
- All functions are expected to be run in CLIENTSIDE context (NamedExecuteClientScript, etc)
- Use NON-fixed ints for x/y position (160, 120 ; instead of 160.0, 120.0)
- hudWidth and hudHeight represent SetHudSize's "scaling" width/height parameters (i.e 320, 240)
*/

// Debug mode : set to true to display error logs, mouse crosshair, and mouse areas' bounding box (note : these bounding boxes use hudMessageId = 1 to 1025)
#DEFINE MGUI_DEBUG false

// -------------------------------------------------------------------------------------------
//      API ~ Rendering
// -------------------------------------------------------------------------------------------

// Draws a graphic on screen
function void Show(int hudMessageId, str graphic, int x, int y, int hudWidth, int hudHeight, int alpha) {
    MGUI_DrawCore(hudMessageId, "A", graphic, x, y, hudWidth, hudHeight, alpha, 0); 
}

// Draws a graphic on screen for 1 tic only
function void Draw(str graphic, int x, int y, int hudWidth, int hudHeight, int alpha) { 
    Show(0, graphic, x, y, hudWidth, hudHeight, alpha); 
}

// ShowText()/DrawText() flags
#DEFINE MGUI_CENTER 0x80000000 // Center text (SetHudSize's x |= 0.4)
#DEFINE MGUI_TYPEON 0x40000000 // Delayed text typing (HUDMSG_TYPEON). For example, for a 0.6s delay, use flags = (MGUI_TYPEON | 0.6)

// Draws text on screen
function void ShowText(int hudMessageId, str text, str font, int x, int y, int hudWidth, int hudHeight, int wrap, int alpha, int flags) {
    MGUI_DrawTextCore(hudMessageId, text, font, x, y, hudWidth, hudHeight, wrap, alpha, flags);
}

// Draws text on screen for 1 tic only
function void DrawText(str text, str font, int x, int y, int hudWidth, int hudHeight, int wrap, int alpha, int flags) { 
    ShowText(0, text, font, x, y, hudWidth, hudHeight, wrap, alpha, flags);
}

// Color the subsequent DrawText()/ShowText() calls by automatically applying a \c[code] TEXTCOLO prefix to them
function void SetTextColor(str code) {
    MGUI_SetTextColorCore(code);
}

// Erase a Show() or ShowText() rendered element from screen
function void Hide(int hudMessageId) { 
    HudMessageBold(s:""; HUDMSG_PLAIN, hudMessageId, 0, 0, 0, 0, 0); 
}

// Shorthand for <count> consecutive Hide() calls, starting from <hudMessageId>
function void HideRange(int hudMessageId, int count) {
    for(int i = 0; i < count; i++) 
        Hide(hudMessageId+i);
}

// Make subsequent render calls not display pixels outside the given rectangle (SetHudClipRect). 
// hudWith is the same value as the element that will be cropped's hudWidth.
// Stop the effect with Uncrop()
function void Crop(int left, int top, int width, int height, int hudWidth) { 
    MGUI_CropCore(left, top, width, height, hudWidth, 0, false);
}

// Stop previous Crop()'s effect
function void Uncrop(void) {
    MGUI_CropCore(0, 0, 0, 0, 0, 0, false);
}

// SetAnchor values
#DEFINE MGUI_LEFT   1
#DEFINE MGUI_RIGHT  2

// Make subsequent Draw/Show calls keep a fixed offset from the left or right screen edge (based on anchorValue)
// Stop the effect with ClearAnchor()
function void SetAnchor(int anchorValue) { 
    MGUI_SetAnchorCore(anchorValue); 
}

function void ClearAnchor(void) {
    MGUI_SetAnchorCore(-1); 
}

// -------------------------------------------------------------------------------------------
//      API ~ Mouse Menu
// -------------------------------------------------------------------------------------------

// Mouse Menu event type for callback script
#DEFINE MGUI_EVENT_ENTER                0 // On mouse enter area
#DEFINE MGUI_EVENT_EXIT                 1 // On mouse leave area
#DEFINE MGUI_EVENT_DOWN                 2 // On fire button press
#DEFINE MGUI_EVENT_UP                   3 // On fire button release
#DEFINE MGUI_EVENT_ALT_DOWN             4 // On altfire button press
#DEFINE MGUI_EVENT_ALT_UP               5 // On altfire button release

// A special areaId value covering the entire screen (usable in AddMouse/RemoveMouse-related event functions)
#DEFINE MGUI_SCREEN_AREA                0x7FFFFFFF

// Enables mouse menu
function bool   StartMouseMenu(void) {              return ACS_NamedExecuteWithResult("MegaUI Mouse Menu"); }

// Stops mouse menu
function void   EndMouseMenu(void) {                ACS_NamedExecuteWithResult("MegaUI API", 0); }

// Registers (or update) the mouse area id = areaId's bounding box
function void   SetMouseArea(int areaId, int x, int y, int hudWidth, int hudHeight, int width, int height) { 
    ACS_NamedExecuteWithResult("MegaUI SetMouseArea API", areaId, (y<<16)|(x+0x7FFF), (hudHeight<<16)|hudWidth, (MGUI_GetAnchor()<<28)|(height<<14)|width); 
}

// Returns true if the mouse is currently hovering the given areaId
function bool   CheckMouseArea(int areaId) {        return ACS_NamedExecuteWithResult("MegaUI API", 8, areaId); }

// Unregisters a mouse area ; also unregisters all its AddMouse-related mouse events
function void   DeleteMouseArea(int areaId) {       ACS_NamedExecuteWithResult("MegaUI API", 1, areaId); }

// Shorthand for <count> consecutive DeleteMouseArea() calls, starting from <areaId>
function void   DeleteMouseAreaRange(int areaId, int count) {
    for(int i = 0; i < count; i++) 
        DeleteMouseArea(areaId+i);
}

    // --------------- Mouse area events --------------- //

// Sets areaId's event handler script to scriptName
function void AddMouseEnter(int areaId, str scriptName) {   ACS_NamedExecuteWithResult("MegaUI API", 9, areaId, MGUI_EVENT_ENTER, scriptName); }
function void AddMouseExit(int areaId, str scriptName) {    ACS_NamedExecuteWithResult("MegaUI API", 9, areaId, MGUI_EVENT_EXIT, scriptName); }
function void AddMouseDown(int areaId, str scriptName) {    ACS_NamedExecuteWithResult("MegaUI API", 9, areaId, MGUI_EVENT_DOWN, scriptName); }
function void AddMouseUp(int areaId, str scriptName) {      ACS_NamedExecuteWithResult("MegaUI API", 9, areaId, MGUI_EVENT_UP, scriptName); }
function void AddMouseAltDown(int areaId, str scriptName) { ACS_NamedExecuteWithResult("MegaUI API", 9, areaId, MGUI_EVENT_ALT_DOWN, scriptName); }
function void AddMouseAltUp(int areaId, str scriptName) {   ACS_NamedExecuteWithResult("MegaUI API", 9, areaId, MGUI_EVENT_ALT_UP, scriptName); }
function void AddAllMouseEvents(int areaId, str scriptName){ACS_NamedExecuteWithResult("MegaUI API", 9, areaId, -1, scriptName); }

// Remove the event handler script from areaId, if it has one
function void RemoveMouseEnter(int areaId) {                ACS_NamedExecuteWithResult("MegaUI API", 10, areaId, MGUI_EVENT_ENTER); }
function void RemoveMouseExit(int areaId) {                 ACS_NamedExecuteWithResult("MegaUI API", 10, areaId, MGUI_EVENT_EXIT); }
function void RemoveMouseDown(int areaId) {                 ACS_NamedExecuteWithResult("MegaUI API", 10, areaId, MGUI_EVENT_DOWN); }
function void RemoveMouseUp(int areaId) {                   ACS_NamedExecuteWithResult("MegaUI API", 10, areaId, MGUI_EVENT_UP); }
function void RemoveMouseAltDown(int areaId) {              ACS_NamedExecuteWithResult("MegaUI API", 10, areaId, MGUI_EVENT_ALT_DOWN); }
function void RemoveMouseAltUp(int areaId) {                ACS_NamedExecuteWithResult("MegaUI API", 10, areaId, MGUI_EVENT_ALT_UP); }
function void RemoveAllMouseEvents(int areaId) {            ACS_NamedExecuteWithResult("MegaUI API", 10, areaId, -1); }



    // --------------- Mouse area misc --------------- //

// Change mouse speed multiplier (default 1.0)
function void   SetMouseSpeed(int speed) {          ACS_NamedExecuteWithResult("MegaUI API", 2, speed); }

// Customize mouse's graphic / pixel offset from origin / graphic scale (Hud Size)
function void   SetCustomMouse(str graphic, int offsetX, int offsetY, int hudWidth, int hudHeight) { 
    ACS_NamedExecuteWithResult("MegaUI API", 3, graphic, ((offsetY+0x7FFF)<<16)|(offsetX+0x7FFF), (hudHeight<<16)|hudWidth); }

/* Mouse's position :
    - For a 4:3 screen resolution, value is [0.0, 1.0] 
    - Wider screens can go over, i.e [-0.3, 1.3] 
*/
function int    GetMouseX(void) {                   return ACS_NamedExecuteWithResult("MegaUI API", 4); }
function void   SetMouseX(int value) {              ACS_NamedExecuteWithResult("MegaUI API", 5, value); }
function int    GetMouseY(void) {                   return ACS_NamedExecuteWithResult("MegaUI API", 6); }
function void   SetMouseY(int value) {              ACS_NamedExecuteWithResult("MegaUI API", 7, value); }

// Get the physical mouse's position difference since previous tic (unitless)
function int    GetRawMouseDeltaX(void) {           return GetPlayerInput(-1, INPUT_YAW); }
function int    GetRawMouseDeltaY(void) {           return (GetPlayerInput(-1, INPUT_PITCH)*GetScreenWidth())/GetScreenHeight(); }

// -------------------------------------------------------------------------------------------
//      API ~ END
// -------------------------------------------------------------------------------------------



