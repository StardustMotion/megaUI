// ---------------------------------------------------------------------------------------------------------------------------------------- //
*/

#DEFINE MGUI_HUD_WIDTH      320
#DEFINE MGUI_HUD_HEIGHT     240

#DEFINE MGUI_CROP_POS       -0x7FFF
#DEFINE MGUI_CROP_SIZE      0xFFFE

#DEFINE MGUI_ANCHOR_NONE    0

#DEFINE MGUI_NO_AREA_ID     -1

int                         mguiCropX = MGUI_CROP_POS,
                            mguiCropY = MGUI_CROP_POS,
                            mguiCropWidth = MGUI_CROP_SIZE,
                            mguiCropHeight = MGUI_CROP_SIZE,
                            mguiCropHudWidth = MGUI_HUD_WIDTH,
                            mguiAnchor = MGUI_ANCHOR_NONE,
                            mguiPlayerWidthCache = -1,
                            mguiPlayerHeightCache = -1,
                            mgui4to3Ratio = 1.0,
                            mguiTextColor = "\c-";

function void   MGUI_Log(str message) {             if(MGUI_DEBUG) log(s:"\c[v7][\c[x5] MegaUI \c[v7]] \c-",s:message); }
function int    MGUI_Min(int x, int y) {            return (x>y ? y : x); }
function int    MGUI_Max(int x, int y) {            return (x>y ? x : y); }
function int    MGUI_Clamp(int n, int l, int r) {   return MGUI_Max(MGUI_Min(n,r),l); }
function int    MGUI_Roundf(int n) {                return (n+0.5)&0xFFFF0000; }

// Calculates (screenWidth/screenHeight) / (4/3)
function int    MGUI_GetScreen4to3Ratio(void) {     
    if((GetScreenWidth() != mguiPlayerWidthCache) || (GetScreenHeight() != mguiPlayerHeightCache)) {
        mguiPlayerWidthCache = GetScreenWidth(),
        mguiPlayerHeightCache = GetScreenHeight(),
        mgui4to3Ratio = FixedDiv(FixedDiv(GetScreenWidth()<<16, GetScreenHeight()<<16),1.333333); 
    }
    return mgui4to3Ratio;
}

// Calculates x position with anchor modifier applied
function int    MGUI_GetAnchoredX(int x, int hudWidth, int anchor) { 
    if(anchor != MGUI_ANCHOR_NONE) {
        int screenOffset = (FixedMul(hudWidth << 16, MGUI_GetScreen4to3Ratio()) - (hudWidth<<16)) >> 17; 
        if(anchor == MGUI_LEFT)         x -= screenOffset;
        else if(anchor == MGUI_RIGHT)   x += screenOffset;
    }
    return x;
}

    ///////////////
    // Rendering //
    ///////////////


function void MGUI_DrawCore(int hudMessageId, str value, str font, int x, int y, int hudWidth, int hudHeight, int alpha, int flags) {
	SetHudSize(hudWidth, hudHeight, true);
	SetFont(font);
    x = MGUI_GetAnchoredX(x, hudWidth, mguiAnchor);
    value = StrParam(s:mguiTextColor, s:value);
    if(flags & MGUI_TYPEON) {
        HudMessageBold(s:value; HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_TYPEON|HUDMSG_COLORSTRING, hudMessageId, CR_UNTRANSLATED,
            (x << 16) | (flags & MGUI_CENTER ? 0.4 : 0), y<<16, 0x8000000, (flags & 0x0FFFFFFF), 0x80000000, alpha);
    }
    else {
        HudMessageBold(s:value; HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_COLORSTRING, hudMessageId, CR_UNTRANSLATED,
            (x << 16) | (flags & MGUI_CENTER ? 0.4 : 0), y<<16, (hudMessageId ? 0x8000000 : 1873), alpha);
    }
}

function void MGUI_DrawTextCore(int hudMessageId, str text, str font, int x, int y, int hudWidth, int hudHeight, int wrap, int alpha, int flags) {
    if(wrap) 
        MGUI_CropCore(mguiCropX, mguiCropY, mguiCropWidth, mguiCropHeight, mguiCropHudWidth, wrap, true);
    MGUI_DrawCore(hudMessageId, text, font, x, y, hudWidth, hudHeight, alpha, flags);
    if(wrap) 
        MGUI_RestoreCrop();
}

function void MGUI_SetTextColorCore(str code) {
    mguiTextColor = StrLen(code) == 1 ? StrParam(s:"\c", s:code) : StrParam(s:"\c[", s:code, s:"]");
}

function void MGUI_CropCore(int left, int top, int width, int height, int hudWidth, int wrap, bool isStateless) { 
    // Crop
    if(width) {
        int x = MGUI_GetAnchoredX(left, hudWidth, mguiAnchor);
        if(!isStateless) {
            mguiCropX = left,
            mguiCropY = top,
            mguiCropWidth = width,
            mguiCropHeight = height,
            mguiCropHudWidth = hudWidth;
        }
        SetHudClipRect(x, top, width, height, wrap);
    }

    // Uncrop
    else {
        if(!isStateless) {
            mguiCropX = MGUI_CROP_POS, 
            mguiCropY = MGUI_CROP_POS, 
            mguiCropWidth = MGUI_CROP_SIZE, 
            mguiCropHeight = MGUI_CROP_SIZE;
        }
        SetHudClipRect(0, 0, 0, 0, 0); 
    }
}

function void MGUI_RestoreCrop(void) {
    MGUI_CropCore(mguiCropX, mguiCropY, mguiCropWidth, mguiCropHeight, mguiCropHudWidth, 0, true);
}

function int MGUI_GetAnchor(void) {
    return mguiAnchor;
}

function void MGUI_SetAnchorCore(int anchorValue) {
    mguiAnchor = anchorValue;
    if(mguiCropX != MGUI_CROP_POS) // Refresh crop left (X) position
        MGUI_RestoreCrop();
}


    /////////////////
    // Mouse menu  //
    /////////////////

#DEFINE MGUI_MOUSE_AREA_MAX         512
#DEFINE MGUI_DEBUG_AREA_DRAWID      1
#DEFINE MGUI_DEBUG_AREA_DRAWID_END  MGUI_DEBUG_AREA_DRAWID+MGUI_MOUSE_AREA_MAX

#DEFINE MGUI_EVENT_SIZE             6 // Enter, Exit, Down, Up, AltDown, AltUp

int     mguiIsMouseMenuRunning =    false,
        mguiMouseGraphic =          "DOOMCURS",
        mguiMouseOffsetX =          7,
        mguiMouseOffsetY =          14,
        mguiMouseX =                0.5,
        mguiMouseY =                0.5,
        mguiMouseHudWidth =         MGUI_HUD_WIDTH,
        mguiMouseHudHeight =        MGUI_HUD_HEIGHT,
        mguiMouseSpeed =            1.0,
        mguiMouseAreaCount;
        
int     mguiMouseAreaScan[MGUI_EVENT_SIZE];

int     mguiMouseAreaIds[MGUI_MOUSE_AREA_MAX+1],
        mguiMouseAreaX1[MGUI_MOUSE_AREA_MAX+1],
        mguiMouseAreaX2[MGUI_MOUSE_AREA_MAX+1],
        mguiMouseAreaY1[MGUI_MOUSE_AREA_MAX+1],
        mguiMouseAreaY2[MGUI_MOUSE_AREA_MAX+1],
        mguiMouseAreaCallback[MGUI_MOUSE_AREA_MAX+1][MGUI_EVENT_SIZE];

function str MGUI_GetMouseAreaCallback(int index, int e) {
    return mguiMouseAreaCallback[index][e]; 
}

function void MGUI_SetMouseAreaCallback(int index, int e, str scriptName) { 
    mguiMouseAreaCallback[index][e] = scriptName; 
}

function int MGUI_FindMouseAreaIndex(int areaId) {
    for(int i = 0; i < mguiMouseAreaCount; i++) {
        if(mguiMouseAreaIds[i] == areaId)
            return i;
    }
    return -1;
}

script "MegaUI API" (int type, int arg1, int arg2, int arg3) CLIENTSIDE {
    switch(type) {

        // End Mouse menu
        case 0:
            mguiIsMouseMenuRunning = false;
            for(int i = 0; i < mguiMouseAreaCount; i++) {
                RemoveAllMouseEvents(mguiMouseAreaIds[i]);
                if(MGUI_DEBUG)
                    Hide(MGUI_DEBUG_AREA_DRAWID+i);
            }
            break;

        // Delete Mouse area
        case 1:
            if(!mguiIsMouseMenuRunning) {
                MGUI_Log("Warning : you must be in a mouse menu to call DeleteMouseArea");
                SetResultValue(false);
                terminate;
            }
            else if(arg1 == MGUI_SCREEN_AREA) {
                MGUI_Log("Warning : tried to DeleteMouseArea the MGUI_SCREEN_AREA areaId (it can't be deleted)");
                terminate;
            }
            type = MGUI_FindMouseAreaIndex(arg1);
            if(type != -1) {
                for(int j = type; j <= mguiMouseAreaCount; j++) {
                    mguiMouseAreaIds[j] =               mguiMouseAreaIds[j+1];
                    mguiMouseAreaX1[j] =                mguiMouseAreaX1[j+1];
                    mguiMouseAreaX2[j] =                mguiMouseAreaX2[j+1];
                    mguiMouseAreaY1[j] =                mguiMouseAreaY1[j+1];
                    mguiMouseAreaY2[j] =                mguiMouseAreaY2[j+1];
                    for(i = 0; i < 6; i++)
                        mguiMouseAreaCallback[j][i] =   mguiMouseAreaCallback[j+1][i];
                }
                mguiMouseAreaCount--;
                Hide(MGUI_DEBUG_AREA_DRAWID+mguiMouseAreaCount);
            }
            break;

        // GetMouseSpeed
        case 2: mguiMouseSpeed = arg1; break;

        // SetCustomMouse
        case 3:
            mguiMouseGraphic = arg1,
            mguiMouseOffsetX = (arg2 & 0xFFFF)-0x7FFF,
            mguiMouseOffsetY = (arg2>>16)-0x7FFF,
            mguiMouseHudWidth = arg3 & 0xFFFF,
            mguiMouseHudHeight = arg3>>16;
            break;

        // GetMouseX
        case 4: SetResultValue(mguiMouseX); break;

        // SetMouseX
        case 5: 
            int screenExtension = (MGUI_GetScreen4to3Ratio()-1.0)>>1;
            mguiMouseX = MGUI_Clamp(arg1, 0-screenExtension, 1.0+screenExtension); 
            break;

        // GetMouseY
        case 6: SetResultValue(mguiMouseY); break;

        // SetMouseY
        case 7: mguiMouseY = MGUI_Clamp(arg1, 0, 1.0); break;

        // CheckMouseArea
        case 8: 
            int index = MGUI_FindMouseAreaIndex(arg1);
            if(index == -1) {
                MGUI_Log(StrParam(s:"Warning : tried to use CheckMouseArea on areaId = ", d:arg1, s:" but it was not defined with SetMouseArea"));
                SetResultValue(false);
                terminate;
            }
            SetResultValue(MGUI_IsWithinAreaId(index));
            break;

        // Add Mouse Event
        case 9: 
            index = MGUI_FindMouseAreaIndex(arg1);
            if(index != -1) {
                if(arg2 != -1)                              MGUI_SetMouseAreaCallback(index, arg2, arg3);
                else { for(i = 0; i < MGUI_EVENT_SIZE; i++) MGUI_SetMouseAreaCallback(index, i, arg3); }
            }
            else
                MGUI_Log(StrParam(s:"Warning : tried to add a mouse event on areaId = ", d:arg1, s:" but it was not defined with SetMouseArea"));
            break;

        // Remove Mouse Event
        case 10:
            index = MGUI_FindMouseAreaIndex(arg1);
            if(index != -1) {
                if(arg2 != -1)                              MGUI_RemoveMouseEvent(arg1, index, arg2);
                else { for(i = 0; i < MGUI_EVENT_SIZE; i++) MGUI_RemoveMouseEvent(arg1, index, i); }
            }
            break;
    }
}

function void MGUI_RemoveMouseEvent(int areaId, int index, int e) {
    str scriptName = MGUI_GetMouseAreaCallback(index, e);
    if(scriptName) {
        // Exit event case : if mouse is hovering the area, call it before unregistering it
        if(e == MGUI_EVENT_EXIT) {
            if(CheckMouseArea(areaId))
                ACS_NamedExecuteWithResult(scriptName, areaId, e);
        }
        MGUI_SetMouseAreaCallback(index, e, 0);
    }
}

script "MegaUI SetMouseArea API" (int areaId, int arg1, int arg2, int arg3) CLIENTSIDE {
    if(!mguiIsMouseMenuRunning) {
        MGUI_Log("Warning : you must be in a mouse menu to call SetMouseArea");
        SetResultValue(false);
        terminate;
    }
    int slot = MGUI_FindMouseAreaIndex(areaId);
    if(slot == -1) {
        if(mguiMouseAreaCount == MGUI_MOUSE_AREA_MAX) {
            MGUI_Log(StrParam(s:"Warning : can't register mouse area, the ", d:MGUI_MOUSE_AREA_MAX, s:" limit is reached!"));
            SetResultValue(false);
            terminate;
        }
        else {
            slot = mguiMouseAreaCount;
            mguiMouseAreaCount++;
            mguiMouseAreaIds[slot] = areaId;
        }
    }

    int x =         (arg1 & 0xFFFF)-0x7FFF,
        y =         arg1 >> 16,
        hudWidth =  arg2 & 0xFFFF,
        hudHeight = arg2 >> 16,
        width =     (arg3 & 0x3FFF),        // 14 bits
        height =    (arg3 >> 14) & 0x3FFF,  // 14 bits
        anchor =    (arg3 >> 28) & 0x3;     // 2 bits
    x -= (width>>1);
    y -= (height>>1);
    int anchoredX = MGUI_GetAnchoredX(x, hudWidth, anchor);

    mguiMouseAreaX1[slot] = FixedDiv(anchoredX<<16, hudWidth<<16);
    mguiMouseAreaX2[slot] = FixedDiv((anchoredX+width)<<16, hudWidth<<16);
    mguiMouseAreaY1[slot] = FixedDiv(y<<16, hudHeight<<16);
    mguiMouseAreaY2[slot] = FixedDiv((y+height)<<16,hudHeight<<16);
    if(MGUI_DEBUG) {
        int tmpAnchor = mguiAnchor;
        SetAnchor(anchor);
        MGUI_CropCore(x, y, width, height, hudWidth, 0, true);
        Show(MGUI_DEBUG_AREA_DRAWID+slot, "MEGAUI_Z", x, y, hudWidth, hudHeight, 0.7);
        SetAnchor(tmpAnchor);
        MGUI_RestoreCrop();
    }
    SetResultValue(true);
}

// The mouse draw/area poll thread
script "MegaUI Mouse Menu" (void) CLIENTSIDE {
    if(mguiIsMouseMenuRunning) {
        MGUI_Log("Warning : tried to start Mouse Menu while one was already running.");
        SetResultValue(false);
        terminate;
    }
    SetResultValue(true);
    mguiIsMouseMenuRunning = true; 
    mguiMouseAreaCount = 0;
    for(int i = 0; i < MGUI_MOUSE_AREA_MAX+1; i++)
        mguiMouseAreaIds[i] = MGUI_NO_AREA_ID;

    SetMouseArea(MGUI_SCREEN_AREA, MGUI_HUD_WIDTH>>3, MGUI_HUD_HEIGHT>>3, MGUI_HUD_WIDTH>>2, MGUI_HUD_HEIGHT>>2, 4096, 4096);

    for(i = 0; i < MGUI_EVENT_SIZE; i++)
        mguiMouseAreaScan[i] = MGUI_NO_AREA_ID;
    int mguiMouseAreaPrevEnter = MGUI_NO_AREA_ID;
    int mguiMouseAreaPrevExit = MGUI_NO_AREA_ID;
    SetMouseX(0.5);
    SetMouseY(0.5);
    while(mguiIsMouseMenuRunning) {
        if(MGUI_DEBUG) {
            int input = false;
            for(i = 0; i < mguiMouseAreaCount; i++) {
                if(mguiMouseAreaIds[i] == MGUI_SCREEN_AREA) 
                    continue;
                else if(MGUI_IsWithinAreaId(i)) {
                    input = true;
                    break;
                }
            }
            Draw(input ? "MEGAUI_X" : "MEGAUI_Y", 
                (GetMouseX()*MGUI_HUD_WIDTH)>>16, (GetMouseY()*MGUI_HUD_HEIGHT)>>16, 
                MGUI_HUD_WIDTH, MGUI_HUD_HEIGHT, 1.0);
        }

        Draw(mguiMouseGraphic,  
            (MGUI_Roundf(GetMouseX()*mguiMouseHudWidth)>>16) + mguiMouseOffsetX, 
            (MGUI_Roundf(GetMouseY()*mguiMouseHudHeight)>>16) + mguiMouseOffsetY, 
            mguiMouseHudWidth, 
            mguiMouseHudHeight, 
            1.0);

            // ------- Event detection ------- // 

        input = GetPlayerInput(-1, INPUT_BUTTONS);
		int inputDelta = GetPlayerInput(-1, INPUT_OLDBUTTONS) ^ input;

        MGUI_ScanMouseAreas();

        // Left click
        if(inputDelta & BT_ATTACK) {
            if(input & BT_ATTACK)       MGUI_Callback(MGUI_EVENT_DOWN);
            else                        MGUI_Callback(MGUI_EVENT_UP);
        }
        // Right click
        else if(inputDelta & BT_ALTATTACK) {
            if(input & BT_ALTATTACK)    MGUI_Callback(MGUI_EVENT_ALT_DOWN);
            else                        MGUI_Callback(MGUI_EVENT_ALT_UP);
        }
        // Mouse exit
        if(mguiMouseAreaPrevExit != mguiMouseAreaScan[MGUI_EVENT_EXIT]) {
            if(mguiMouseAreaPrevExit != MGUI_NO_AREA_ID) {
                // Callback the previous areaId
                i = mguiMouseAreaPrevExit;
                mguiMouseAreaPrevExit = mguiMouseAreaScan[MGUI_EVENT_EXIT];
                mguiMouseAreaScan[MGUI_EVENT_EXIT] = i;
                MGUI_Callback(MGUI_EVENT_EXIT);
            }
            else 
                mguiMouseAreaPrevExit = mguiMouseAreaScan[MGUI_EVENT_EXIT];
        }
        // Mouse enter
        if(mguiMouseAreaPrevEnter != mguiMouseAreaScan[MGUI_EVENT_ENTER]) {
            mguiMouseAreaPrevEnter = mguiMouseAreaScan[MGUI_EVENT_ENTER];
            MGUI_Callback(MGUI_EVENT_ENTER);
        }
      

        // Mouse delta
        delay(1);
        int delta = GetRawMouseDeltaX();
        if(delta)
            SetMouseX(mguiMouseX - ((FixedMul(FixedMul(delta<<16, mguiMouseSpeed), 1.7)>>15)));
        delta = GetRawMouseDeltaY();
        if(delta)
            SetMouseY(mguiMouseY - ((FixedMul(FixedMul(delta<<16, mguiMouseSpeed), 1.7)>>15)));
    }
}

function void MGUI_ScanMouseAreas(void) {
    for(int e = 0; e < MGUI_EVENT_SIZE; e++)
        mguiMouseAreaScan[e] = MGUI_NO_AREA_ID;

    int x = GetMouseX(), 
        y = GetMouseY();
    for(int i = 0; i < mguiMouseAreaCount; i++) {
        // Check if within rectangle
        if(MGUI_IsWithinAreaId(i)) {
            for(e = 0; e < MGUI_EVENT_SIZE; e++) {
                // Check if event type is registered
                if(MGUI_GetMouseAreaCallback(i, e)) {
                    // Check if has lower areaId (== higher layer priority)
                    int areaId = mguiMouseAreaIds[i]; 
                    if(mguiMouseAreaScan[e] == MGUI_NO_AREA_ID)
                        mguiMouseAreaScan[e] = areaId;
                    else if(areaId < mguiMouseAreaScan[e])
                        mguiMouseAreaScan[e] = areaId;
                }
            }
        }
    }
}

function bool MGUI_IsWithinAreaId(int index) {
    int x = GetMouseX(), y = GetMouseY();
    if(x >= mguiMouseAreaX1[index]) { if(x < mguiMouseAreaX2[index]) { if(y >= mguiMouseAreaY1[index]) { if(y < mguiMouseAreaY2[index])
        return true;
    } } }
    return false;
}

function void MGUI_Callback(int e) {
    int areaId = mguiMouseAreaScan[e];
    if(areaId != MGUI_NO_AREA_ID) {
        str scriptName = MGUI_GetMouseAreaCallback(MGUI_FindMouseAreaIndex(areaId), e);
        if(scriptName)
            ACS_NamedExecuteWithResult(scriptName, areaId, e);
    }
}

// Stops mouse menu on game enter / spectate since the script gets interrupted 
script "MegaUI ENTER" ENTER CLIENTSIDE {
    if(ConsolePlayerNumber() == PlayerNumber())
        EndMouseMenu();
}

script "MegaUI DISCONNECT" (int player) DISCONNECT CLIENTSIDE {
    if(ConsolePlayerNumber() == player)
        EndMouseMenu();
}

