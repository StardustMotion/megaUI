// -------------------------------------------------------------------------------------------
//     Dance dance revolution
// -------------------------------------------------------------------------------------------

/*  
        [ Dance dance revolution game ]

    > Mouse area ids are given #DEFINE names for easier management. They're either
        - The 4 grey arrows
            - Highlighted on mouse hover
            - React/consume the beat on click
        - The right menu items
            - Turn to big font on hover
            - Control game state on click
    > 3 songs
    > Use Draw() for the notes (since they change position every frame) ; and Show() for everything else
*/


// ================ Defs / data / consts ================ //

#DEFINE DDR_INPUT_COUNT     4 // 4 arrows
#DEFINE DDR_TRACK_COUNT     3
#DEFINE DDR_MAX_NOTES       256 // max beats / notes per track

#DEFINE DDR_NOTE_PERFECT_Y  139 // Grey arrow position
#DEFINE DDR_NOTE_START_Y    738 // Note spawn position

#DEFINE DDR_ARROW_WIDTH     984
#DEFINE DDR_ARROW_HEIGHT    738

// Track BPM / delay() between beats
#DEFINE DDR_BPM_117         9   // => 116.67 BPM
#DEFINE DDR_BPM_150         7

// Mouse area ids
#DEFINE AREAID_ARROWS               0                               // [0, DDR_INPUT_COUNT = 4[
#DEFINE AREAID_MENU_START           AREAID_ARROWS           +DDR_INPUT_COUNT
    #DEFINE AREAID_MENU_STOP        AREAID_MENU_START
    #DEFINE AREAID_MENU_TRACKS      AREAID_MENU_STOP        +1
    #DEFINE AREAID_MENU_METRONOM    AREAID_MENU_TRACKS      +DDR_TRACK_COUNT
    #DEFINE AREAID_MENU_EXIT        AREAID_MENU_METRONOM    +1
#DEFINE AREAID_MENU_END             AREAID_MENU_EXIT        +1

// HudMessageIds
#DEFINE DRAWID_DDR_TITLE            2000
#DEFINE DRAWID_DDR_JUDGMENT         DRAWID_DDR_TITLE +1
#DEFINE DRAWID_DDR_COMBO            DRAWID_DDR_JUDGMENT +1
#DEFINE DRAWID_DDR_ARROWS           DRAWID_DDR_COMBO+1
#DEFINE DRAWID_DDR_ARROW_HIGHLIGHT  DRAWID_DDR_ARROWS +DDR_INPUT_COUNT
#DEFINE DRAWID_DDR_MENU             DRAWID_DDR_ARROW_HIGHLIGHT +DDR_INPUT_COUNT
#DEFINE DRAWID_DDR_BG               DRAWID_DDR_MENU +(AREAID_MENU_END-AREAID_MENU_START)

// Grey arrow click bounce animation 
#DEFINE DDR_ARROW_ANIM_T    5  // Duration
int ddrPress[DDR_INPUT_COUNT]; // Duration status

// Grey arrows
int ddrArrowBasePic[DDR_INPUT_COUNT] = {        "MEGAUIG6", "MEGAUIG9", "MEGAUIG7", "MEGAUIG8" };

// Colored arrows
int ddrArrowBeatPic[3][DDR_INPUT_COUNT] = {
    { "MEGAUIGA", "MEGAUIGD", "MEGAUIGB", "MEGAUIGC" }, // 1/1 beat
    { "MEGAUIGM", "MEGAUIGQ", "MEGAUIGO", "MEGAUIGP" }, // 1/2 beat
    { "MEGAUIGN", "MEGAUIGT", "MEGAUIGR", "MEGAUIGS" }, // 1/4 beat
};




// ================ Track data  ================ //

// Music code
int ddrTrackCode[DDR_TRACK_COUNT] = {
   "MEGAUIM0", 
   "MEGAUIM1", 
   "MEGAUIM2",
};

// Track display name
int ddrTrackName[DDR_TRACK_COUNT] = {
   "Savaged Regime - Comix Zone ~ Episode 1 Page 2-1 (YM2612)",
   "Zero Wing - Gerbarra (Stage 8)",
   "Allanx - Overclocked (Forgotten Navi Theme)",
};

int ddrTrackBPM[DDR_TRACK_COUNT] = {
   DDR_BPM_117,
   DDR_BPM_150,
   DDR_BPM_150,
};

// Beatmap : 0 (None), 1 Left, 2 Down, 3 Up, 4 Right
int ddrTrackBeatmap[DDR_TRACK_COUNT][DDR_MAX_NOTES] = {
    // Track 1
    {
        1, 0, 3, 0,     1, 0, 3, 0,     4, 0, 3, 0,     2, 0, 3, 0, 
