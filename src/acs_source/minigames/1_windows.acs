
// -------------------------------------------------------------------------------------------
//     Windows
// -------------------------------------------------------------------------------------------

/*  
        [ Close all opened windows mini game ]

    > For simplicity, windows are closable from last to first spawned
        - Window interaction on/off is updated accordingly when a window spawns/gets closed
    > The cursor is custom ; changes upon hovering close button
*/

#DEFINE WINDOWS_MAX     16

#DEFINE DRAWID_WINDOWS_TITLE    2000
#DEFINE DRAWID_WINDOWS_START    DRAWID_WINDOWS_TITLE +1
#DEFINE DRAWID_WINDOWS_END      DRAWID_WINDOWS_START + WINDOWS_MAX

int windowAreaIdCount = 0;

script "MegaUI Windows" (void) CLIENTSIDE {

	// Start the mouse menu / receive callback events in given script
    if(!StartMouseMenu())
        terminate;

	SetPlayerProperty(0, true, PROP_TOTALLYFROZEN);

	MGUIGames_DebugMessage(true);
	AddMouseAltDown(MGUI_NULL_AREA, MEGAUI_DEBUG_SCRIPT_CALLBACK);
	AddMouseAltUp(MGUI_NULL_AREA, MEGAUI_DEBUG_SCRIPT_CALLBACK);

    LocalAmbientSound("MEGAUIG5", 127);
    SetWindowCursor(false);
    delay(35);
    for(int i = 0; i < 8; i++) { 
        AddWindow(); 
        delay(4); 
    }
    EnableWindowEvents(windowAreaIdCount);
    while(true) {
        for(i = 0; i < 145; i++) {
            delay(1);

            // End game
            if(windowAreaIdCount == 0) {
                Hide(DRAWID_WINDOWS_TITLE);
                delay(10);
                LocalAmbientSound("MEGAUIG5", 127);
                MGUIGames_DebugMessage(false);
                ShowText(DRAWID_WINDOWS_TITLE, "\cfV I C T O R Y", "bigfont", 160, 29, 320, 240, 0, 1.0, MGUI_TYPEON|0.04);
                EndMouseMenu();
                SetCustomMouse("DOOMCURS", 7, 14, 320, 240);
                delay(50);
                SetPlayerProperty(0, false, PROP_TOTALLYFROZEN);
                Hide(DRAWID_WINDOWS_TITLE);
                terminate;
            }
        }
        if(windowAreaIdCount < WINDOWS_MAX) {
            AddWindow();
            DisableWindowEvents(windowAreaIdCount-1);
            EnableWindowEvents(windowAreaIdCount);
        }
    }
}


#DEFINE WINDOWS_HUD_WIDTH 877
#DEFINE WINDOWS_HUD_HEIGHT 657
// Push a new window
function void AddWindow(void) {
    LocalAmbientSound("MEGAUIG4", 127);
    windowAreaIdCount++;

    int hudMessageId = DRAWID_WINDOWS_END-windowAreaIdCount,
        x = random(280, 520),
        y = random(230, 420);
    // Window graphic ~ Id 2016 => 2015 => 2014...
    Show(hudMessageId, "megauig5", x, y, WINDOWS_HUD_WIDTH, WINDOWS_HUD_HEIGHT, 1.0); 

    // Close button : areaId 1 => 2 => 3...
    SetMouseArea(windowAreaIdCount, x+219, y-152, WINDOWS_HUD_WIDTH, WINDOWS_HUD_HEIGHT, 36, 36); 
    RefreshWindowTitle();
}

function void RefreshWindowTitle(void) {
	ShowText(DRAWID_WINDOWS_TITLE, StrParam(s:"\cdWindows left ", d:windowAreaIdCount, s:" / ", d:WINDOWS_MAX), "bigfont", 160, 10, 320, 240, 0, 1.0, 0);
}

function void SetWindowCursor(bool isHover) {
    // Finger position is displayed under the mouse position
    if(isHover)
        SetCustomMouse("MEGAUIGK", 0, 11, 640, 480);
    // Pointer position is displayed at bottom right hand corner of mouse position
    else
        SetCustomMouse("MEGAUIGL", 5, 10, 640, 480);
}


    // ########################################## //
    // ----------------- EVENTS ----------------- //
    // ########################################## //

// Make a window interactable
function void EnableWindowEvents(int areaId) {
    AddMouseEnter(areaId, "MegaUI Windows On Enter");
    AddMouseExit(areaId, "MegaUI Windows On Exit");
    AddMouseDown(areaId, "MegaUI Windows On Click");
}

// Make a window non-interactable
function void DisableWindowEvents(int areaId) {
    RemoveMouseEnter(areaId);
    RemoveMouseExit(areaId);
    RemoveMouseDown(areaId);
    // Manual exit event trigger, in case it was being hovered
    ACS_NamedExecuteWithResult("MegaUI Windows On Exit", areaId); 
}

// On hovering topmost window mouse area- turn mouse cursor into a finger
script "MegaUI Windows On Enter" (void) {
	SetWindowCursor(true);
}

// On exit mouse area area - revert mouse cursor to a pointer
script "MegaUI Windows On Exit" (void) {
	SetWindowCursor(false);
}

// On fire press on a window's [X]
script "MegaUI Windows On Click" (int areaId) {
    DeleteMouseArea(areaId);
    Hide(DRAWID_WINDOWS_END-windowAreaIdCount);
    windowAreaIdCount--;
    RefreshWindowTitle();
    LocalAmbientSound("MEGAUIG6", 127);
    SetWindowCursor(false);

    // Next underneath window becomes interactable
    if(windowAreaIdCount > 0)
        EnableWindowEvents(windowAreaIdCount);
}
