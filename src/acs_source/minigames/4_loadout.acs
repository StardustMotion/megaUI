// -------------------------------------------------------------------------------------------
//     Item loadout 
// -------------------------------------------------------------------------------------------

/*  
		[ A two-layered menu : 1) pick a slot 2) pick that slot's item from a library ]
	
	> ALL mouse areas are registered right on start
	> Then, event handlers are added/removed based on which menu layer 
		is currently active (EnableLoadoutSlotMenu() / EnableLoadoutLibraryMenu())
*/

#DEFINE LOADOUT_COUNT 		3
#DEFINE LOADOUT_MAX			1000 // max items in the table
#DEFINE LOADOUT_COLUMNS 	8	
#DEFINE LOADOUT_ROWS		8
#DEFINE LOADOUT_PAGE_SIZE	(LOADOUT_COLUMNS*LOADOUT_ROWS)
#DEFINE LOADOUT_PAGE_MAX	1 + (LOADOUT_MAX/LOADOUT_PAGE_SIZE)
#DEFINE LOADOUT_ANIMATION_T 8

// Mouse area ids

#DEFINE AREAID_SLOTS				100					-1
#DEFINE AREAID_CONFIRM				AREAID_SLOTS 		-1
#DEFINE AREAID_ITEMS				AREAID_CONFIRM 		-LOADOUT_PAGE_SIZE
#DEFINE AREAID_SWAP_RIGHT			AREAID_ITEMS 		-1
#DEFINE AREAID_SWAP_LEFT			AREAID_SWAP_RIGHT	-LOADOUT_COUNT

// HudMessageIds

#DEFINE DRAWID_LOADOUT_SLOTS_MENU	4000						-1
#DEFINE DRAWID_LOADOUT_SLOTS		DRAWID_LOADOUT_SLOTS_MENU	-LOADOUT_COUNT
#DEFINE DRAWID_LOADOUT_CONFIRM		DRAWID_LOADOUT_SLOTS		-1
#DEFINE DRAWID_LOADOUT_LIBRARY_MENU	DRAWID_LOADOUT_CONFIRM		-1
#DEFINE DRAWID_LOADOUT_ITEM_ICONS	DRAWID_LOADOUT_LIBRARY_MENU	-LOADOUT_PAGE_SIZE
#DEFINE DRAWID_LOADOUT_SWAP_RIGHT	DRAWID_LOADOUT_ITEM_ICONS	-1
#DEFINE DRAWID_LOADOUT_SWAP_LEFT  	DRAWID_LOADOUT_SWAP_RIGHT	-1
#DEFINE DRAWID_LOADOUT_PAGE			DRAWID_LOADOUT_SWAP_LEFT	-1
#DEFINE DRAWID_LOADOUT_ITEM_NAME	DRAWID_LOADOUT_PAGE			-1
#DEFINE DRAWID_LOADOUT_RETICLE		DRAWID_LOADOUT_ITEM_NAME	-1

int 	loadout[LOADOUT_COUNT];
int 	libraryPage,
		selectedLoadoutSlot = -1;

script "MegaUI Loadout" (void) CLIENTSIDE {

    if(!StartMouseMenu())
        terminate;

	SetPlayerProperty(0, true, PROP_TOTALLYFROZEN);
	LocalAmbientSound("MEGAUIG8", 127);
	
	// Slot menu background
	Show(DRAWID_LOADOUT_SLOTS_MENU, "MEGAUIGU", 546/2, 364/2, 546, 364, 1.0);

	UpdateLoadoutConfirm(false);
	
	// ----------- Mouse area registering ----------- //

	// Slots
	for(int slot = 0; slot < LOADOUT_COUNT; slot++) {
		SetLoadEquipped(slot, slot);
		SetMouseArea(AREAID_SLOTS+slot, GetSlotX(slot), 81, 216, 162, 28, 28);
	}
	// Confirm button
	SetMouseArea(AREAID_CONFIRM, 115, 116, 230, 149, 68, 20);

	// Library items
	for(int row = 0; row < LOADOUT_ROWS; row++) {
		for(int column = 0; column < LOADOUT_COLUMNS; column++) {
			int index = (row*LOADOUT_COLUMNS) + column;
			SetMouseArea(AREAID_ITEMS+index, GetLibraryItemX(column), GetLibraryItemY(row), 352, 264, 20, 20);
		}
	}

	// Library swap arrows
	SetMouseArea(AREAID_SWAP_LEFT, 	128, 47, 360, 229, 24, 24);
	SetMouseArea(AREAID_SWAP_RIGHT, 233, 47, 360, 229, 24, 24);

	// ----------------------------------------- //

	EnableLoadoutSlotMenu();
}

// Change one of the 3 slots' item and refresh its draw
function void SetLoadEquipped(int slot, int itemId) {
	loadout[slot] = itemId;
	ShowText(DRAWID_LOADOUT_SLOTS+slot, StrParam(s:"\c[n5]", d:itemId), "bigfont", GetSlotX(slot), 81, 216, 162, 0, 1.0, 0);
}

function int GetSlotX(int slot) { 
	return 73+34*slot;
}


// The zoom in/out window popup animation upon selecting a slot
function void DrawLibraryAnimation(int progress) {
	int hudWidth = 9115 - (FixedMul((9115-434)<<16, progress)>>16);
	int hudHeight = 6836 - (FixedMul((6836-325)<<16, progress)>>16);
	Show(DRAWID_LOADOUT_LIBRARY_MENU, "megauigx", hudWidth/2, hudHeight/2, hudWidth, hudHeight, 0.4+(FixedMul(progress, 0.6)));
}

// Set up items' mouse area / update page's menu
function void SetLibraryPage(int pageIndex) {
	libraryPage = pageIndex;
	// Show menu
	if(pageIndex != -1) {
		EnableLoadoutLibraryMenu();
		ShowText(DRAWID_LOADOUT_PAGE, StrParam(s:"\ck", d:pageIndex+1, s:"/", d:LOADOUT_PAGE_MAX), "bigfont", 180, 47, 360, 229, 0, 1.0, 0);
		// Change default text color for items
		SetTextColor("h7");
		for(int row = 0; row < LOADOUT_ROWS; row++) {
			for(int column = 0; column < LOADOUT_COLUMNS; column++) {
				int itemIndex = (row*LOADOUT_COLUMNS) + column;
				// Last item : remove number/mouse areas from remaining space
				if((pageIndex * LOADOUT_PAGE_SIZE) + itemIndex == LOADOUT_MAX) {
					for(int i = itemIndex; i < LOADOUT_PAGE_SIZE; i++) {
						Hide(DRAWID_LOADOUT_ITEM_ICONS+i);
						RemoveMouseEnter(AREAID_ITEMS+i);
						RemoveMouseExit(AREAID_ITEMS+i);
						RemoveMouseDown(AREAID_ITEMS+i);
					}
					return;
				}
				ShowText(DRAWID_LOADOUT_ITEM_ICONS+itemIndex, StrParam(d:itemIndex+(pageIndex * LOADOUT_PAGE_SIZE)), "bigfont", 
					166+36*column, 97+26*row, 582, 313, 0, 1.0, 0);
			}
		}
	}
	// Hide menu
	else {
		HideRange(DRAWID_LOADOUT_ITEM_ICONS, LOADOUT_PAGE_SIZE);
		return;
	}
}

function int GetLibraryItemX(int column) {
	return 100 + 22 * column;
}

function int GetLibraryItemY(int row) {
	return 82 + 22 * row;
}

// Update page arrow rendering
function void SetPageArrow(int hudMessageId, int state) {
	if(state == -1)
		Hide(hudMessageId);
	else {
		if(hudMessageId == DRAWID_LOADOUT_SWAP_LEFT) {
			str graphic = (state == 1) ? "MEGAUIGZ" : "MEGAUIGY";
			int x = 128;
		}
		else {
			graphic = (state == 1) ? "MEGAUIG]" : "MEGAUIG[";
			x = 233;
		}
		Show(hudMessageId, graphic, x, 47, 360, 229, 1.0);
	}
}

						// ########################################## //
						// ----------------- EVENTS ----------------- //
						// ########################################## //



    // ----------------- Slots ----------------- //

script "MegaUI Loadout On Slot Enter" (int areaId) {
	Show(DRAWID_LOADOUT_RETICLE, "MEGAUIGW", 45+21*(areaId - AREAID_SLOTS), 50, 133, 100, 1.0);
	LocalAmbientSound("MEGAUIGA", 127);
}

script "MegaUI Loadout On Slot Exit" (int areaId) {
	Hide(DRAWID_LOADOUT_RETICLE);
}

script "MegaUI Loadout On Slot Click" (int areaId) {
	LocalAmbientSound("MEGAUIG2", 127);
	Hide(DRAWID_LOADOUT_RETICLE);

	// Animation
	DisableLoadoutSlotMenu();
	for(int i = 0; i <= LOADOUT_ANIMATION_T; i++) {
		DrawLibraryAnimation(FixedDiv(i<<16, LOADOUT_ANIMATION_T<<16));
		delay(1);
	}

	// Open first page
	selectedLoadoutSlot = (areaId - AREAID_SLOTS);
	SetLibraryPage(0);
	SetPageArrow(DRAWID_LOADOUT_SWAP_LEFT, 0);
	SetPageArrow(DRAWID_LOADOUT_SWAP_RIGHT, 0);
}



    // ----------------- Confirm button ----------------- //

script "MegaUI Loadout On Confirm Enter" (void) {
	UpdateLoadoutConfirm(true);
	LocalAmbientSound("MEGAUIGA", 127);
}

script "MegaUI Loadout On Confirm Exit" (void) {
	UpdateLoadoutConfirm(false);
}

script "MegaUI Loadout On Confirm Click" (void) {
	LocalAmbientSound("MEGAUIG8", 127);
	SetPlayerProperty(0, false, PROP_TOTALLYFROZEN);
	for(int i = 0; i < LOADOUT_COUNT; i++)
		log(s:"Received abstract item #", d:loadout[i]);
	EndMouseMenu();
	Hide(DRAWID_LOADOUT_CONFIRM);
	Hide(DRAWID_LOADOUT_SLOTS_MENU);
	HideRange(DRAWID_LOADOUT_SLOTS, LOADOUT_COUNT);
}

function void UpdateLoadoutConfirm(bool isFocused) {
	ShowText(DRAWID_LOADOUT_CONFIRM, "\c[n9]CONFIRM", (isFocused ? "BIGFONT" : "SMALLFONT"), 115, 117, 230, 149, 0, 1.0, 0);
}

    // ----------------- Library item ----------------- //

script "MegaUI Loadout On Item Enter" (int areaId) {
	int index = areaId - AREAID_ITEMS;
	ShowText(DRAWID_LOADOUT_ITEM_NAME, StrParam(s:"Item #", d:index + (libraryPage * LOADOUT_PAGE_SIZE)), "bigfont", 
		210, 25, 420, 240, 0, 1.0, 0);
	LocalAmbientSound("MEGAUIGA", 127);
	Show(DRAWID_LOADOUT_RETICLE, "MEGAUIGW", 
		GetLibraryItemX(index % LOADOUT_COLUMNS), GetLibraryItemY(index / LOADOUT_COLUMNS), 352, 264, 1.0);
}

script "MegaUI Loadout On Item Exit" (int areaId) {
	Hide(DRAWID_LOADOUT_ITEM_NAME);
	Hide(DRAWID_LOADOUT_RETICLE);
}

script "MegaUI Loadout On Item Click" (int areaId) {
	LocalAmbientSound("MEGAUIG9", 127);
	int index = areaId - AREAID_ITEMS;
	SetLoadEquipped(selectedLoadoutSlot, index + (libraryPage * LOADOUT_PAGE_SIZE));
	Hide(DRAWID_LOADOUT_RETICLE);
	Hide(DRAWID_LOADOUT_ITEM_NAME);
	Hide(DRAWID_LOADOUT_PAGE);
	SetPageArrow(DRAWID_LOADOUT_SWAP_LEFT, -1);
	SetPageArrow(DRAWID_LOADOUT_SWAP_RIGHT, -1);
	selectedLoadoutSlot = -1;
	SetLibraryPage(-1);
		
	// Animation
	DisableLoadoutLibraryMenu();
	for(int i = LOADOUT_ANIMATION_T; i >= 0; i--) {
		DrawLibraryAnimation(FixedDiv(i<<16, LOADOUT_ANIMATION_T<<16));
		delay(1);
	}
	EnableLoadoutSlotMenu();
	Hide(DRAWID_LOADOUT_LIBRARY_MENU);
}



    // ----------------- Library arrow / page swap ----------------- //

script "MegaUI Loadout On Swap Enter" (int areaId) {
	LocalAmbientSound("MEGAUIGA", 127);
	SetPageArrow(areaId == AREAID_SWAP_LEFT ? DRAWID_LOADOUT_SWAP_LEFT : DRAWID_LOADOUT_SWAP_RIGHT, 1);
}

script "MegaUI Loadout On Swap Exit" (int areaId) {
	SetPageArrow(areaId == AREAID_SWAP_LEFT ? DRAWID_LOADOUT_SWAP_LEFT : DRAWID_LOADOUT_SWAP_RIGHT, 0);
}

script "MegaUI Loadout On Swap Click" (int areaId) {
	LocalAmbientSound("MEGAUIGA", 127);
	SetLibraryPage(areaId == AREAID_SWAP_LEFT ?
		(libraryPage - 1 + LOADOUT_PAGE_MAX) % LOADOUT_PAGE_MAX
		: (libraryPage + 1) % LOADOUT_PAGE_MAX);
}


    // ----------------- Handlers operations ----------------- //

// Slots interaction on/off

function void EnableLoadoutSlotMenu(void) {
	for(int i = 0; i < LOADOUT_COUNT; i++) {
		AddMouseEnter(AREAID_SLOTS+i, "MegaUI Loadout On Slot Enter");
		AddMouseExit(AREAID_SLOTS+i, "MegaUI Loadout On Slot Exit");
		AddMouseDown(AREAID_SLOTS+i, "MegaUI Loadout On Slot Click");
	}
	AddMouseEnter(AREAID_CONFIRM, "MegaUI Loadout On Confirm Enter");
	AddMouseExit(AREAID_CONFIRM, "MegaUI Loadout On Confirm Exit");
	AddMouseDown(AREAID_CONFIRM, "MegaUI Loadout On Confirm Click");
}

function void DisableLoadoutSlotMenu(void) {
	for(int i = 0; i < LOADOUT_COUNT; i++)
		RemoveAllMouseEvents(AREAID_SLOTS+i);
	RemoveAllMouseEvents(AREAID_CONFIRM);
}

// Library interaction on/off

function void EnableLoadoutLibraryMenu(void) {
	for(int i = 0; i < LOADOUT_PAGE_SIZE; i++) {
		AddMouseEnter(AREAID_ITEMS+i, "MegaUI Loadout On Item Enter");
		AddMouseExit(AREAID_ITEMS+i, "MegaUI Loadout On Item Exit");
		AddMouseDown(AREAID_ITEMS+i, "MegaUI Loadout On Item Click");
	}
	AddMouseEnter(AREAID_SWAP_LEFT, "MegaUI Loadout On Swap Enter");
	AddMouseEnter(AREAID_SWAP_RIGHT, "MegaUI Loadout On Swap Enter");
	AddMouseExit(AREAID_SWAP_LEFT, "MegaUI Loadout On Swap Exit");
	AddMouseExit(AREAID_SWAP_RIGHT, "MegaUI Loadout On Swap Exit");
	AddMouseDown(AREAID_SWAP_LEFT, "MegaUI Loadout On Swap Click");
	AddMouseDown(AREAID_SWAP_RIGHT, "MegaUI Loadout On Swap Click");
}

function void DisableLoadoutLibraryMenu(void) {
	for(int i = 0; i < LOADOUT_PAGE_SIZE; i++)
		RemoveAllMouseEvents(AREAID_ITEMS+i);
	RemoveAllMouseEvents(AREAID_SWAP_LEFT);
	RemoveAllMouseEvents(AREAID_SWAP_RIGHT);
}
